#!/bin/bash
# Solo Studio launcher — runs the dashboard with no Terminal window.
# First launch creates a private Python environment and installs what it
# needs (about a minute); after that, launches are instant.
set -u

RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
SUPPORT="$HOME/Library/Application Support/Solo Studio"
LOG="$SUPPORT/launcher.log"
mkdir -p "$SUPPORT"
exec >> "$LOG" 2>&1
echo "=== launch $(date) ==="

dialog() {
    local msg
    msg=$(printf '%s' "$1" | /usr/bin/tr -d '"\\')   # keep osascript quoting safe
    /usr/bin/osascript -e "display dialog \"$msg\" with title \"Solo Studio\" buttons {\"OK\"} default button 1 with icon caution" >/dev/null 2>&1 || true
}
notify() {
    /usr/bin/osascript -e "display notification \"$1\" with title \"Solo Studio\"" >/dev/null 2>&1 || true
}

# If the dashboard is already running, just open it in the browser.
if /usr/bin/nc -z 127.0.0.1 8747 >/dev/null 2>&1; then
    /usr/bin/open "http://127.0.0.1:8747/"
    exit 0
fi

# Find a suitable Python. The app needs 3.11–3.13: the Python bundled with
# macOS's developer tools (3.9) is too old, and 3.14+ is too NEW for some of
# the app's components. Prefer the newest one inside the supported range.
PY313_URL="https://www.python.org/ftp/python/3.13.7/python-3.13.7-macos11.pkg"
PY=""
PY_BEST=0
PY_ANY=0
for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3 \
         /opt/homebrew/bin/python3.* /usr/local/bin/python3.* \
         /Library/Frameworks/Python.framework/Versions/*/bin/python3; do
    [ -x "$c" ] || continue
    v="$("$c" -c 'import sys; print(sys.version_info[0]*100 + sys.version_info[1])' 2>/dev/null)" || continue
    [ -n "$v" ] || continue
    [ "$v" -gt "$PY_ANY" ] && PY_ANY="$v"
    if [ "$v" -ge 311 ] && [ "$v" -le 313 ] && [ "$v" -gt "$PY_BEST" ]; then
        PY_BEST="$v"
        PY="$c"
    fi
done
echo "picked python: ${PY:-none} (best=$PY_BEST, any=$PY_ANY)"
if [ -z "$PY" ]; then
    if [ "$PY_ANY" -ge 314 ]; then
        dialog "The Python on this Mac is version 3.14 or newer — too new for some of Solo Studio's components. I'll download the Python 3.13 installer for you; run it, then open Solo Studio again. (Python 3.13 installs alongside, nothing breaks.)"
    else
        dialog "Solo Studio needs Python 3.13, which isn't on this Mac yet. I'll download the installer for you — run it, then open Solo Studio again."
    fi
    /usr/bin/open "$PY313_URL"
    exit 1
fi

# Private environment with the app's dependencies.
VENV="$SUPPORT/venv"
if [ ! -x "$VENV/bin/python3" ] || ! "$VENV/bin/python3" -c 'import flask, requests, anthropic, inkbox' >/dev/null 2>&1; then
    notify "First-time setup: installing components (about a minute)…"
    rm -rf "$VENV"
    if ! "$PY" -m venv "$VENV"; then
        dialog "Couldn't set up the Python environment. Details are in launcher.log inside ~/Library/Application Support/Solo Studio."
        exit 1
    fi
    "$VENV/bin/python3" -m pip install --upgrade pip
    PIPLOG="$SUPPORT/pip-install.log"
    if ! "$VENV/bin/python3" -m pip install --prefer-binary flask requests anthropic inkbox > "$PIPLOG" 2>&1; then
        cat "$PIPLOG"
        ERR="$(grep -m1 -E 'ERROR:|error:' "$PIPLOG" | cut -c1-220)"
        dialog "Couldn't install Solo Studio's components. The installer said: ${ERR:-unknown error — see launcher.log in ~/Library/Application Support/Solo Studio}. If this mentions 'No matching distribution' or a Python version, install the newest Python from python.org and try again."
        rm -rf "$VENV"
        exit 1
    fi
    notify "Setup finished — opening your dashboard."
fi

exec "$VENV/bin/python3" "$RES/dashboard_app.py" --open-browser
